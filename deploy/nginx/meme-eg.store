# System Nginx site config for meme-eg.store — this box's Nginx is SHARED
# with other projects (currently also `amarel7ewety.com`), so this file
# lives in /etc/nginx/sites-available/meme-eg.store, symlinked from
# sites-enabled, alongside (never replacing) the other project's own file.
# There is no Docker Nginx in this project — see docker-compose.yml.
#
# Install: sudo cp deploy/nginx/meme-eg.store /etc/nginx/sites-available/meme-eg.store
#          sudo ln -sf /etc/nginx/sites-available/meme-eg.store /etc/nginx/sites-enabled/meme-eg.store
#          sudo nginx -t && sudo systemctl reload nginx
# See docs/VPS_DEPLOYMENT.md for the full TLS bootstrap sequence (this file
# assumes a cert already exists at the paths below — the bootstrap doc
# covers issuing it the first time with a temporary HTTP-only version of
# this file).

proxy_cache_path /var/cache/nginx/meme levels=1:2 keys_zone=meme_cache:10m max_size=200m inactive=60m use_temp_path=off;

server {
    listen 80;
    server_name meme-eg.store www.meme-eg.store;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name meme-eg.store www.meme-eg.store;

    ssl_certificate     /etc/letsencrypt/live/meme-eg.store/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/meme-eg.store/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 15m; # covers the 10MB product-image upload limit + headroom

    # Stripe webhook: raw body must reach the app completely untouched —
    # verifying the signature depends on byte-for-byte fidelity.
    location /api/stripe/webhook {
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Micro-cache the three read-heavy public JSON endpoints — replaces
    # Vercel's edge cache for these routes.
    location ~ ^/api/(products|homepage|categories) {
        proxy_cache meme_cache;
        proxy_cache_valid 200 300s;
        proxy_cache_use_stale updating error timeout http_500 http_502 http_503;
        proxy_cache_background_update on;
        add_header X-Cache-Status $upstream_cache_status;
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Object storage — served through the same domain/TLS cert so the
    # frontend's <Image> remotePatterns and CORS stay simple.
    location /media/ {
        rewrite ^/media/(.*)$ /$1 break;
        proxy_pass http://127.0.0.1:9002;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
