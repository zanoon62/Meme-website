# Postgres (self-hosted, replaces Supabase — see docker-compose.dev.yml for local dev)
DATABASE_URL=postgres://meme:meme_dev@localhost:5432/meme_dev
# Only used by production docker-compose.yml to provision the postgres
# container itself — DATABASE_URL above is what the app actually connects
# with locally; in production docker-compose.yml builds DATABASE_URL from
# these three automatically.
POSTGRES_USER=meme
POSTGRES_PASSWORD=change_me_to_a_real_secret
POSTGRES_DB=meme

# Redis (rate limiting + Nginx-fronted caching — see docker-compose.dev.yml)
REDIS_URL=redis://localhost:6379

# Object storage (self-hosted MinIO, replaces Supabase Storage)
# In production these are overridden by docker-compose.yml (MINIO_ENDPOINT=minio
# on the internal network) — only MINIO_PUBLIC_URL, MINIO_ACCESS_KEY,
# MINIO_SECRET_KEY need real values in the deployed .env. MINIO_PUBLIC_URL
# should point at the Nginx /media/ proxy, e.g. https://yourdomain.com/media
# (see deploy/nginx/meme-store.conf), not directly at MinIO's port.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_PUBLIC_URL=http://localhost:9000

# Google OAuth (customer + admin login — configure at
# https://console.cloud.google.com/auth/clients, redirect URI:
# <NEXT_PUBLIC_SITE_URL>/auth/callback)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# Resend (order confirmation emails)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=orders@yourdomain.com

NEXT_PUBLIC_SITE_URL=http://localhost:3000
LOG_LEVEL=info
NODE_ENV=development

# Admin dev-only password login (admin / admin123) — disabled automatically
# in production (NODE_ENV=production), see src/lib/auth/simple-auth.ts.
# Real admin access in production is Google OAuth + the admin_allowed_emails
# whitelist table, managed via the admin panel by the super-admin account.
