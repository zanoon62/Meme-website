# Supabase (optional — only needed for product/order DB features, NOT for admin login)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# z-ai-web-dev-sdk (required for AI features)
ZAI_API_KEY=your_zai_api_key_here

# Admin login (simple hardcoded — admin / admin123)
# No env var needed. To change, edit src/lib/auth/simple-auth.ts
